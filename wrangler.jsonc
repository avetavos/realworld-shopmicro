{
  // Cloudflare Worker (static assets) for the ShopMicro guide.
  // The site is built with Astro `base: '/shopmicro'`, so the built files must be
  // served under a `/shopmicro/` path. `npm run deploy` stages `dist/` into
  // `.cf-assets/shopmicro/` and serves `.cf-assets` as the asset root.
  "name": "realworld-shopmicro",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./.cf-assets"
  },
  // projects.avetavos.com is the shared host (taskflow owns it as a custom
  // domain). ShopMicro is served under /shopmicro/* (Astro base) via a
  // more-specific Workers route, the same way DevBlog is routed.
  "routes": [
    { "pattern": "projects.avetavos.com/shopmicro/*", "zone_name": "avetavos.com" }
  ]
}
